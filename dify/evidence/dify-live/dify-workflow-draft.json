      {
        "data": {
          "code": "import json\n\n\nWEIGHTS = {\"offense\": 25, \"favor\": -18, \"secret\": 12, \"neutral\": 0}\nLABELS = {\"offense\": \"冒犯\", \"favor\": \"人情\", \"secret\": \"秘密\", \"neutral\": \"闲话\"}\n\n\ndef main(prepare_body: str, list_body: str) -> dict:\n    ctx, grudge, entries = \"\", 0, []\n    try:\n        prepared = json.loads(prepare_body)\n        if isinstance(prepared, dict):\n            ctx = prepared.get(\"content\") or \"\"\n    except Exception:\n        ctx = \"\"\n    try:\n        listed = json.loads(list_body)\n        if isinstance(listed, dict):\n            entries = listed.get(\"entries\") or []\n    except Exception:\n        entries = []\n\n    counts = {k: 0 for k in WEIGHTS}\n    for item in entries:\n        if not isinstance(item, dict):\n            continue\n        kind = item.get(\"kind\") or \"neutral\"\n        if kind not in counts:\n            kind = \"neutral\"\n        counts[kind] += 1\n        grudge += WEIGHTS[kind]\n    grudge = max(0, min(100, grudge))\n\n    stat = \"／\".join(f\"{LABELS[k]}{counts[k]}\" for k in LABELS)\n    lines = [f\"共 {len(entries)} 条：{stat}\"]\n    for item in entries[-5:]:\n        if not isinstance(item, dict):\n            continue\n        kind = item.get(\"kind\") or \"neutral\"\n        if kind not in LABELS:\n            kind = \"neutral\"\n        text = str(item.get(\"text\") or \"\").strip().replace(\"\\n\", \" \")\n        lines.append(f\"- [{LABELS[kind]}] {text[:88]}\")\n    if not entries:\n        lines.append(\"-（账本还是空的，这位客人第一次来）\")\n\n    return {\n        \"context\": ctx if ctx.strip() else \"（没有检索到旧事）\",\n        \"grudge\": str(grudge),\n        \"ledger_text\": \"\\n\".join(lines),\n        \"visit_count\": str(len(entries) + 1),\n    }\n",
          "code_language": "python3",
          "desc": "把 prepare 召回的上下文与账本条目合成为「怨气值 + 恩怨账本摘要」",
          "outputs": {
