        "data": {
          "code": "import json\nimport re\n\n\nKINDS = {\"offense\", \"favor\", \"secret\", \"neutral\"}\n\n\ndef main(judge_text: str, user_said: str) -> dict:\n    raw = judge_text or \"\"\n    match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n    kind, deed = \"neutral\", \"\"\n    if match:\n        try:\n            data = json.loads(match.group(0))\n            if isinstance(data, dict):\n                kind = str(data.get(\"kind\") or \"\").strip()\n                deed = str(data.get(\"deed\") or \"\").strip()\n        except Exception:\n            pass\n    if kind not in KINDS:\n        kind = \"neutral\"\n    if not deed:\n        deed = \"冒险者在吧台前丢下一句话，账房先生记下了原委。\"\n    said = \" \".join(str(user_said or \"\").split())[:180]\n    ledger = f\"{deed[:200]}（原话：{said}）\" if said else deed[:200]\n    return {\n        \"kind\": kind,\n        \"ledger_json\": json.dumps(ledger, ensure_ascii=False),\n    }\n",
          "code_language": "python3",
