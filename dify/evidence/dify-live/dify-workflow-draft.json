        "data": {
          "code": "import json\nimport re\n\n\ndef main(player_id: str, user_id: str, utterance: str) -> dict:\n    raw = (player_id or \"\").strip()\n    if not raw:\n        user = (user_id or \"\").strip()\n        raw = \"dx-\" + user[:8] if user else \"guest\"\n    key = re.sub(r\"[^0-9A-Za-z_\\u4e00-\\u9fff-]\", \"-\", raw)[:48] or \"guest\"\n    said = (utterance or \"\").strip() or \"（冒险者沉默不语）\"\n    return {\n        \"player_key\": key,\n        \"query_json\": json.dumps(said, ensure_ascii=False),\n        \"reason_json\": json.dumps(\"玩家原话：\" + said, ensure_ascii=False),\n    }\n",
          "code_language": "python3",
          "desc": "规范化玩家ID（留空则用 Dify 会话用户兜底），并把本回合原话转成可直接拼进 JSON 的安全字面量",
